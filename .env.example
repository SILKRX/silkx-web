# Публичные (попадают в браузер)
NEXT_PUBLIC_SITE_URL=https://silkx.uz
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Только сервер (НИКОГДА не префиксовать NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Яндекс Карты (необязательно). Пусто → бесплатная карта OpenStreetMap.
# Ключ: developer.tech.yandex.ru → «JavaScript API и HTTP Геокодер»
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# AI-ассистент (Claude API). Пусто → ассистент отвечает по встроенным правилам на 6 языках.
# Ключ: console.anthropic.com → API Keys. Только сервер — НИКОГДА не добавляйте NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Необязательно: другая модель Claude (по умолчанию claude-haiku-5-5 — быстрая и недорогая)
ASSISTANT_MODEL=

# Телефон в уведомлениях Telegram: full (по умолчанию) или masked («+998 90 ***-**-67»).
# masked включайте, когда полные заявки хранятся в базе на сервере в Узбекистане (закон «О персональных данных», ст. 27-1).
TELEGRAM_PII=full
